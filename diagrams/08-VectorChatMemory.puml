@startuml
skinparam linetype ortho
skinparam sequenceMessageAlign center

actor User
participant ChatClient
participant "VectorStoreChatMemoryAdvisor" as Advisor
database "VectorStore" as VectorStore
participant "EmbeddingModel" as EmbeddingModel
participant "ChatModel / LLM" as LLM

User -> ChatClient : Prompt
ChatClient -> Advisor : adviseCall / adviseStream(...)

group vor Prompt Ausführung

Advisor -> VectorStore : similaritySearch(conversationId, userMessage)
VectorStore -> EmbeddingModel : Embedding für userMessage erzeugen
EmbeddingModel --> VectorStore : Embedding-Vektor
VectorStore --> Advisor : relevante frühere Nachrichten

Advisor -> Advisor : Prompt mit relevanten Nachrichten erweitern

Advisor -> VectorStore : add(conversationId, userMessage)
VectorStore -> EmbeddingModel : Embedding für userMessage erzeugen
EmbeddingModel --> VectorStore : Embedding-Vektor

end

Advisor -> LLM : erweiterter Prompt
LLM --> Advisor : Antwort

group nach Prompt Ausführung

Advisor -> VectorStore : add(conversationId, assistantMessage)
VectorStore -> EmbeddingModel : Embedding für assistantMessage erzeugen
EmbeddingModel --> VectorStore : Embedding-Vektor

end

Advisor --> ChatClient : Antwort
ChatClient --> User : Antwort
@enduml