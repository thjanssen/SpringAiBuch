<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
	<groupId>com.thorben.janssen.spring.ai.buch</groupId>
	<artifactId>parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Spring_AI_Buch</name>
	<description>Backend demo project for Spring AI book</description>
    <packaging>pom</packaging>

    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <vaadin.version>25.0.0</vaadin.version>
        <spring-ai.version>2.1.0-RC1</spring-ai.version>
        <spring-ai-a2a.version>0.4.0</spring-ai-a2a.version>
        <!-- A2A Java SDK 1.x (org.a2aproject.sdk) für die Spring AI Agenten -->
        <a2a-java-sdk.version>1.4.0.Final</a2a-java-sdk.version>
        <!-- A2A Java SDK 0.3.x (io.github.a2asdk) für die Embabel Agenten -->
        <a2a-sdk.version>0.3.3.Final</a2a-sdk.version>
        <embabel-agent.version>1.5.2</embabel-agent.version>
    </properties>

	<dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.embabel.agent</groupId>
                <artifactId>embabel-agent-dependencies</artifactId>
                <version>${embabel-agent.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>in.virit</groupId>
                <artifactId>viritin</artifactId>
                <version>3.0.1</version>
            </dependency>
        </dependencies>
	</dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <executions>
                    <execution>
                        <id>build-frontend</id>
                        <goals>
                            <goal>build-frontend</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <!-- Snapshot Builds, z.B. von Spring AI A2A -->
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <modules>
        <module>02_ErsteAnwendung</module>
        <module>03_Prompting_Rollen</module>
        <module>03_Prompting_PromptTemplate</module>
        <module>03_Prompting_StructuredOutput</module>
        <module>04_Test</module>
        <module>04_Test_TestcontainersOllama</module>
        <module>04_Test_TestcontainersDockerModelRunner</module>
        <module>05_MultiModality_Audio</module>
        <module>05_MultiModality_Image</module>
        <module>05_MultiModality_Moderation</module>
        <module>05_MultiModality_Embedding</module>
        <module>06_MultiModel</module>
        <module>07_Advisors</module>
        <module>07_Advisors_GuardrailAdvisor</module>
        <module>08_ChatMemory_WindowInMemory</module>
        <module>08_ChatMemory_VectorStoreAdvisor</module>
        <module>08_ChatMemory_WindowJdbc</module>
        <module>08_ChatMemory_SessionJdbc</module>
        <module>09_RAG</module>
        <module>09_RAG_Docling</module>
        <module>10_ToolCalling</module>
        <module>10_ToolCalling_Augmentation</module>
        <module>10_ToolCalling_ToolSearchTool</module>
        <module>10_ToolCalling_Security</module>
        <module>10_ToolCalling_HumanLoop</module>
        <module>11_AgenticRAG</module>
        <module>12_MCPClient</module>
        <module>12_MCPServer_Web</module>
        <module>12_MCPServer_StdIO</module>
        <module>13_Agents_MCPServer</module>
        <module>13_Agents_OrderAgent</module>
        <module>13_Agents_ProductAdvisorAgent</module>
        <module>13_Agents_Chatbot</module>
        <module>13_Agents_Embabel_MCPServer</module>
        <module>13_Agents_Embabel_OrderAgent</module>
        <module>13_Agents_Embabel_ProductAdvisorAgent</module>
        <module>13_Agents_Embabel_Chatbot</module>
        <module>14_Observability</module>
        <module>15_Modell_OpenAI_Websearch</module>
        <module>15_Modell_OpenAI_Reasoning</module>
        <module>15_Modell_Anthropic_PromptCaching</module>
        <module>15_Modell_Anthropic_WebSearch</module>
        <module>15_Modell_Anthropic_Thinking</module>
        <module>15_Modell_Anthropic_InferenceGeo</module>
    </modules>
</project>
